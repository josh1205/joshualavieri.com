---
import { Image } from 'astro:assets'
import astroIcon from '../assets/astro-icon.png'
import pulumiIcon from '../assets/pulumi-icon.png'
import { BRANDS } from '@data/brands.ts'
import { SITE } from '../config.ts'
import { getLangFromUrl, useTranslations } from '../i18n/utils'
import ChipLink from './ChipLink.astro'

/** The stack this site runs on, plus where the source lives. */
const BADGES = [
  { label: 'GitHub', href: SITE.links.repo, brand: 'github' as const },
  { label: 'Cloudflare', href: 'https://www.cloudflare.com', brand: 'cloudflare' as const },
]

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)
const year = new Date().getFullYear()

/**
 * Mirrors the pair at the bottom of the sidebar. The sidebar hides its copy
 * once the layout stacks, so these are the only ones on small viewports.
 */
const SMALL_LINKS = [
  { label: t('sidebar.resume'), href: '/resume/' },
  { label: t('sidebar.source'), href: SITE.links.repo },
]
---

<footer class="mt-16 border-t border-edge pt-8 pb-4">
  {/* `display` comes from .footer-small-links, which only shows below the
      stacking breakpoint — hence no `flex` utility here. */}
  <ul class="footer-small-links mono-meta mb-6 flex-wrap items-center gap-x-2 text-ink-muted">
    {
      SMALL_LINKS.map((link, i) => (
        <>
          {i > 0 && <li aria-hidden="true" class="opacity-50">|</li>}
          <li>
            <a
              href={link.href}
              class="text-ink-muted no-underline transition-colors hover:text-accent"
            >
              {link.label}
            </a>
          </li>
        </>
      ))
    }
  </ul>

  <ul class="flex flex-wrap items-center gap-2">
    <li>
      <ChipLink href="https://astro.build" variant="badge" external>
        <Image
          src={astroIcon}
          alt=""
          width={18}
          densities={[1, 2]}
          class="size-4.5 shrink-0 object-contain"
        />
        Astro
      </ChipLink>
    </li>

    {
      BADGES.map((badge) => (
        <li>
          <ChipLink href={badge.href} variant="badge" external>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox={BRANDS[badge.brand].viewBox}
              fill={BRANDS[badge.brand].color ?? 'currentColor'}
              class="size-4.5 shrink-0"
              aria-hidden="true"
            >
              <path d={BRANDS[badge.brand].path} />
            </svg>
            {badge.label}
          </ChipLink>
        </li>
      ))
    }

    <li>
      <ChipLink href="https://www.pulumi.com" variant="badge" external>
        <Image
          src={pulumiIcon}
          alt=""
          width={18}
          densities={[1, 2]}
          class="size-4.5 shrink-0 object-contain"
        />
        Pulumi
      </ChipLink>
    </li>
  </ul>

  <p class="mono-meta mt-5 text-ink-muted">
    &copy; {year} {SITE.author}. {t('footer.builtWith')}
  </p>

  <p class="mono-meta mt-1 text-ink-muted">
    {t('footer.designCredit')} <a href="https://tania.dev" target="_blank">tania.dev</a>.
  </p>
</footer>

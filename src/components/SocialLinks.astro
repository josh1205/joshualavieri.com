---
import Tooltip from './Tooltip.astro'
import { BRANDS } from '@data/brands.ts'

/**
 * Icon size in px. A variable rather than a class because it drives both the
 * SVG box and the ligature font-size, and Tailwind can't generate a class
 * built from a variable.
 */
const ICON_SIZE = 25

interface SocialLink {
  label: string
  href: string
  icon?: string
  brand?: keyof typeof BRANDS
  target?: string
}

interface Props {
  links: readonly SocialLink[]
  /** Smaller hit area, sized to match the theme/language toggles in the
      stacked-layout bar. */
  compact?: boolean
}



const { links, compact = false } = Astro.props
// Compact icons are sized by .bar-control in global.css, so that the bar can
// scale them per breakpoint — an inline width would beat any rule there.
const box = `width:${ICON_SIZE}px;height:${ICON_SIZE}px`
---

<ul class="flex items-center gap-1">
  {
    links.map((link) => (
      <li>
        <Tooltip label={link.label} srHidden>
          <a
            href={link.href}
            target={link.target}
            rel={link.target === '_blank' ? 'noopener noreferrer' : undefined}
            aria-label={link.label}
            class:list={[
              'text-ink-muted no-underline transition-colors hover:bg-tag hover:text-ink-strong',
              !compact && 'grid place-items-center',
              compact ? 'bar-control' : 'size-10 rounded-md',
            ]}
          >
            {
              link.brand ? (
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox={BRANDS[link.brand].viewBox}
                  fill="currentColor"
                  style={compact ? undefined : box}
                  aria-hidden="true"
                >
                  <path d={BRANDS[link.brand].path} />
                </svg>
              ) : (
                <span
                  class="material-symbols-outlined block leading-none"
                  style={compact ? undefined : `font-size:${ICON_SIZE}px`}
                  aria-hidden="true"
                >
                  {link.icon}
                </span>
              )
            }
          </a>
        </Tooltip>
      </li>
    ))
  }
</ul>

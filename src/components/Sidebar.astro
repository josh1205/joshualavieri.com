---
import { Image } from 'astro:assets'
import SiteNav from './SiteNav.astro'
import SocialLinks from './SocialLinks.astro'
import ThemeToggle from './ThemeToggle.astro'
import LanguageToggle from './LanguageToggle.astro'
import F1Race from './F1Race.astro'
import Tooltip from './Tooltip.astro'
import { getLangFromUrl, useTranslations, localeHref } from '../i18n/utils'
import { SITE } from '../config.ts'
import logo from '../assets/logo.png'
// import blogIcon from '../assets/blog.png'
import projectsIcon from '../assets/projects.png'
import meIcon from '../assets/me.png'

/**
 * Logo width in px. Drives BOTH the rendered size and the resolution Astro
 * generates, so it stays sharp when enlarged.
 *
 * Ceiling: the sidebar caps it. Usable width is
 *   --sidebar-width (370) - padding (2 x 32) - controls (2 x 34) - gaps (2 x 8) = 222px
 * Past that the logo just fills the row; raise --sidebar-width in
 * global.css to go bigger.
 */
const LOGO_WIDTH = 220

/**
 * Logo width once the layout stacks. The sidebar becomes a single bar there,
 * shared with the toggles, the social icons and the menu button.
 */
const LOGO_WIDTH_MOBILE = 180

const LOGO_ALT = "Josh's Digital Workshop"

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)



const NAV = [
  { label: t('nav.projects'), href: localeHref('/projects/', lang), image: projectsIcon },
  // Add once you post your first blog
  // { label: 'Blog', href: '/blog/', image: blogIcon },
  { label: t('nav.about'), href: localeHref('/me/', lang), image: meIcon },
]

const SOCIAL = [
  { label: 'GitHub profile', href: SITE.links.github, brand: 'github', target: '_blank' },
  { label: 'LinkedIn', href: SITE.links.linkedIn, brand: 'linkedIn', target: '_blank' },
  // Add once you post your first blog
  // { label: 'RSS', href: '/rss.xml', icon: 'rss_feed' },
] as const


/** The bar has room for one social icon; the rest stay in the sidebar foot. */
const BAR_SOCIAL = SOCIAL.filter((link) => link.brand === 'linkedIn')

const FOOTER_LINKS = [
  { label: t('sidebar.resume'), href: '/resume/' },
  { label: t('sidebar.source'), href: SITE.links.repo },
]

const currentPath = Astro.url.pathname
---

<aside class="layout-sidebar">
  <div class="flex items-center gap-2">
    <a
      href={localeHref('/', lang)}
      class="sidebar-logo block min-w-0 no-underline"
      style={`--logo-width:${LOGO_WIDTH}px;--logo-width-mobile:${LOGO_WIDTH_MOBILE}px`}
    >
      {/*
        Black artwork on transparency, so it would disappear against the dark
        surface — `dark:invert` flips it to cream. width+densities emits 1x/2x
        only, keeping the 900KB source out of the build.

        The rendered width comes from the custom properties above rather than
        an inline `width:`, so the stacked layout can shrink it — an inline
        style would beat any stylesheet rule.
      */}
      <Image
        src={logo}
        alt={LOGO_ALT}
        width={LOGO_WIDTH}
        densities={[1, 2]}
        class="dark:invert"
        loading="eager"
      />
    </a>

    <div class="sidebar-bar-actions flex shrink-0 items-center gap-1">
      <LanguageToggle />
      <Tooltip label={t('sidebar.theme')} srHidden class="shrink-0">
        <ThemeToggle />
      </Tooltip>

      {/* Stacked layout only — the full social row lives at the bottom of a
          real sidebar, which is hidden at that width. */}
      <div class="sidebar-bar-social">
        <SocialLinks links={BAR_SOCIAL} compact />
      </div>

      <button
        type="button"
        data-nav-toggle
        aria-expanded="false"
        aria-controls="site-menu"
        aria-label={t('sidebar.openMenu')}
        data-label-open={t('sidebar.openMenu')}
        data-label-close={t('sidebar.closeMenu')}
        class="sidebar-nav-toggle bar-control text-ink-muted transition-colors hover:bg-tag hover:text-ink-strong"
      >
        {/* Three bars that fold into an X when the menu is open. Drawn in CSS
            so it costs nothing in the icon-font subset. */}
        <span class="hamburger" aria-hidden="true">
          <span></span>
          <span></span>
          <span></span>
        </span>
      </button>
    </div>
  </div>

  {/* Sidebar-only: the stacked menu is just the links, on a blank sheet. */}
  <div class="sidebar-bio">
    <hr class="my-5 border-edge" />

    <p class="text-[1rem]">
      <span>{t('sidebar.bioLead')}</span>
      <a href="/me/">{t('sidebar.bioName')}</a>
      <span>{t('sidebar.bioRest')}</span>
    </p>

    <hr class="my-5 border-edge" />
  </div>

  <div id="site-menu" class="sidebar-panel">
    <SiteNav items={NAV} currentPath={currentPath} />
  </div>

  {/* Takes the column's free space (`margin-top: auto` in global.css), so it
      sits directly above the social row and the cars arrive from below it. */}
  <F1Race />

  <div class="sidebar-foot pt-6">
    <SocialLinks links={SOCIAL} />

    {/* Below the stacking breakpoint this whole block is hidden and the
        same two links are rendered by Footer.astro instead. */}
    <ul class="mono-meta mt-4 flex flex-wrap items-center gap-x-2 text-ink-muted text-sm">
      {
        FOOTER_LINKS.map((link, i) => (
          <>
            {i > 0 && <li aria-hidden="true" class="opacity-50">|</li>}
            <li>
              <a
                href={link.href}
                class="text-ink-muted no-underline transition-colors hover:text-accent"
              >
                {link.label}
              </a>
            </li>
          </>
        ))
      }
    </ul>
  </div>
</aside>

<script>
  /**
   * Menu button: toggles `data-nav-open` on the sidebar, which is what the
   * stylesheet keys the panel and the bars-to-X animation off. Desktop shows
   * the panel unconditionally, so the attribute is inert there.
   */
  const sidebar = document.querySelector<HTMLElement>('.layout-sidebar')
  const toggle = sidebar?.querySelector<HTMLButtonElement>('[data-nav-toggle]')

  if (sidebar && toggle) {
    toggle.addEventListener('click', () => {
      const open = sidebar.toggleAttribute('data-nav-open')
      // Scoped to the stacked breakpoint by the stylesheet, so a stale class
      // after a resize past it does nothing.
      document.documentElement.classList.toggle('nav-open', open)
      toggle.setAttribute('aria-expanded', String(open))
      const label = open ? toggle.dataset.labelClose : toggle.dataset.labelOpen
      if (label) toggle.setAttribute('aria-label', label)
    })
  }
</script>

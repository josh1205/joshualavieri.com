---
import Tooltip from './Tooltip.astro'
import {
  getLangFromUrl,
  useTranslations,
  alternateUrl,
  isTranslatable,
} from '../i18n/utils'

/**
 * Plain link to the same page in the other language — no JavaScript, and the
 * URL is real, so it's shareable and indexable.
 *
 * On pages listed in UNTRANSLATED_PATHS the control stays visible but inert,
 * so the sidebar doesn't reflow between pages and the reason is discoverable.
 */
const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)
const enabled = isTranslatable(Astro.url)

const label = enabled ? t('sidebar.switchLang') : t('sidebar.notTranslated')

// A capitalised variable renders as a dynamic tag: <a> when it links
// anywhere, <span> when there's nothing to link to.
const Tag = enabled ? 'a' : 'span'
---

<Tooltip
  label={label}
  class="shrink-0"
  srHidden={enabled}
  focusable={!enabled}
>
  <Tag
    href={enabled ? alternateUrl(Astro.url, lang) : undefined}
    hreflang={enabled ? (lang === 'en' ? 'af' : 'en') : undefined}
    aria-label={enabled ? label : undefined}
    aria-disabled={enabled ? undefined : 'true'}
    class:list={[
      'bar-control text-ink-muted transition-colors',
      enabled
        ? 'no-underline hover:bg-tag hover:text-ink-strong'
        : 'cursor-not-allowed opacity-40',
    ]}
  >
    <span class="material-symbols-outlined block leading-none" aria-hidden="true"
      >translate</span
    >
  </Tag>
</Tooltip>
